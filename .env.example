# Required
OPENAI_API_KEY=sk-proj-...

# Optional defaults. The app runs without changing these.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_RESPONSE_MODEL=gpt-5.6-luna
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_VOICE=alloy
OPENAI_TTS_FORMAT=mp3
OPENAI_REQUEST_TIMEOUT_SECONDS=60
APP_HOST=127.0.0.1
APP_PORT=8000

# Bengali eval studio (transcription tiers + dataset store)
OPENAI_TRANSCRIBE_MODEL_FAST=gpt-4o-mini-transcribe
OPENAI_TRANSCRIBE_MODEL_BEST=gpt-transcribe
DATA_DIR=data
DATASET_PAGE_SIZE_DEFAULT=50
